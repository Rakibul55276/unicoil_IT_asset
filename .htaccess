Options -Indexes
ServerSignature Off

RewriteEngine On

# Application source, database utilities, documentation, and runtime output
# must never be served by Apache.
RewriteRule ^(?:app|database|integrations|output|tmp|\.git|\.agents|\.codex)(?:/|$) - [F,L,NC]
# Agent source is included internally through compatibility entry points; only its CSS is public.
RewriteRule ^agent-module/(?:src|database|views|public)(?:/|$) - [F,L,NC]
RewriteRule ^agent-module/(?:bootstrap\.php|README\.md)$ - [F,L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)$ index.php?url=$1 [L,QSA]

<FilesMatch "(?i)^(?:config(?:\.example)?|bootstrap)\.php$|^(?:README|LICENSE|CHANGELOG|error_log|php_errorlog)|\.(?:sql|log|ini|env|bak|backup|old|dist|ya?ml)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'"
</IfModule>
